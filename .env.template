# Copy to .env (local) and set the same variables in the Vercel project. Never commit .env.
# The guides build without any of these: they are needed by sign-in and the collection only.

# MongoDB Atlas: the app's user, with the readWrite role on the database only
MONGODB_URI=
# Only for `yarn db:setup --apply`: a user with the dbAdmin role (validators, indexes)
MONGODB_ADMIN_URI=
# Database name (default: nowhere)
MONGODB_DB=

# Auth.js: generate the secret with `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth client. Redirect URIs: http://localhost:8354/api/auth/callback/google and
# https://<production domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Who may sign in: comma-separated emails. Nobody else can create an account.
ALLOWED_EMAILS=

# Photo storage: any S3-compatible bucket, private (Cloudflare R2 proposed, docs/data-model.md §6.7)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
